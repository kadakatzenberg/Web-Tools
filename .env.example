# Optional overrides. When unset, the app falls back to the public project
# already used by the deployed site. The anon key is a public client credential
# by design — access is governed by row-level security, not by hiding this value.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key
