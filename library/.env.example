# Both are optional. Unset, the app uses the Supabase project the deployed
# site already points at.
#
# The anon key is a public client credential by design — it ships in the
# bundle because a browser has to identify itself to PostgREST somehow. What
# stops a stranger rewriting the archive is row-level security, not this
# string. See docs/SECURITY.md.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key
